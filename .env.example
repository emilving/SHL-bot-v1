# Discord-botens token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=
# Kanalen där uppdateringarna ska postas (högerklicka kanalen -> Kopiera kanal-ID)
DISCORD_CHANNEL_ID=
# Valfritt: server-ID gör att slash-kommandona syns direkt i stället för efter upp till en timme
DISCORD_GUILD_ID=

# Följ bara vissa lag, kommaseparerade lagkoder (tomt = alla SHL-matcher)
SHL_TEAMS=
# Hur ofta pågående matcher kontrolleras (sekunder)
POLL_INTERVAL=10
# Posta startande målvakter vid nedsläpp (1/0)
POST_STARTING_GOALIES=1

# Avancerat: SHL:s endpoints. Ändra om SHL byter adresser (se README).
# SHL_BASE_URL=https://www.shl.se
# SHL_OVERVIEW_PATH=/api/gameday/game-overview/{uuid}
# SHL_PBP_PATH=/api/gameday/play-by-play/{uuid}
# SHL_TEAM_STATS_PATH=/api/gameday/team-stats/{uuid}
# SHL_SERIES_CODE=SHL
# STATE_FILE=state.json
